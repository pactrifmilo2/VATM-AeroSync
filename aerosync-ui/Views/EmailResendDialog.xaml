<ContentDialog
    x:Class="AeroSync.UI.Views.EmailResendDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chọn file để gửi lại qua Gmail"
    PrimaryButtonText="Gửi lại qua Gmail"
    SecondaryButtonText="Hủy"
    IsPrimaryButtonEnabled="False">
    <ScrollViewer MaxHeight="610" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Width="520">
            <Border Background="#F8FAFC" BorderBrush="#D9E2EF" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock Text="{Binding Email.Sender}" Foreground="#0B5CAD" FontWeight="Bold" />
                        <TextBlock Text="{Binding Email.Subject}" TextWrapping="Wrap" Foreground="#334155" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="{Binding Email.ReceivedLabel}" Foreground="#334155" />
                        <TextBlock Text="{Binding Email.MaskedMessageId}" FontFamily="Consolas" FontSize="11" Foreground="#64748B" />
                        <TextBlock Text="{Binding AttachmentLabel}" FontWeight="SemiBold" Foreground="#102A56" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="Chọn ít nhất một trạng thái" FontWeight="Bold" Foreground="#102A56" />
                <ListView ItemsSource="{Binding StatusOptions}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#D9E2EF" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,3">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}" Checked="StatusCheckBox_Changed" Unchecked="StatusCheckBox_Changed" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="#174A8B" />
                                        <TextBlock Text="{Binding Description}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#EEF4FF" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count}" Foreground="#174A8B" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid ColumnSpacing="9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <SymbolIcon Grid.Column="0" Symbol="Important" Foreground="#C2410C" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="Hệ thống tạo email Gmail mới và không xóa permit ATFM. File giống bản cũ vẫn phải qua kiểm tra SHA-256 và có thể được đánh dấu duplicate." Foreground="#9A3412" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14">
                <TextBlock x:Name="SelectionSummaryText" Foreground="#174A8B" FontWeight="SemiBold" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
