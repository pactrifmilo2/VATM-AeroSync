<Page x:Class="AeroSync.UI.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F6F8FC">
    <StackPanel Padding="28,24,28,32" Spacing="20">
        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="#102A43" />
                <TextBlock Text="{Binding Subtitle}" Foreground="#64748B" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="12" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" />
        </Grid>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="4"><TextBlock Text="{Binding SuccessLabel}" Foreground="#15803D" FontWeight="SemiBold" /><TextBlock Text="{Binding SuccessCount}" Foreground="#166534" FontSize="28" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="4"><TextBlock Text="{Binding ErrorLabel}" Foreground="#BE123C" FontWeight="SemiBold" /><TextBlock Text="{Binding ErrorCount}" Foreground="#9F1239" FontSize="28" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="4"><TextBlock Text="{Binding WarningLabel}" Foreground="#C2410C" FontWeight="SemiBold" /><TextBlock Text="{Binding WarnCount}" Foreground="#9A3412" FontSize="28" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="4"><TextBlock Text="{Binding SkippedLabel}" Foreground="#1D4ED8" FontWeight="SemiBold" /><TextBlock Text="{Binding SkippedCount}" Foreground="#1E40AF" FontSize="28" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Grid.Column="4" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="4"><TextBlock Text="{Binding ProcessingLabel}" Foreground="#6D28D9" FontWeight="SemiBold" /><TextBlock Text="{Binding ProcessingCount}" Foreground="#5B21B6" FontSize="28" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Grid.Column="5" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="4"><TextBlock Text="{Binding TotalLabel}" Foreground="#475569" FontWeight="SemiBold" /><TextBlock Text="{Binding TotalJobs}" Foreground="#1E293B" FontSize="28" FontWeight="Bold" /></StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Page>