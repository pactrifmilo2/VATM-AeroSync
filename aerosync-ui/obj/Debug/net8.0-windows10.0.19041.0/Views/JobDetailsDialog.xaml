<ContentDialog x:ConnectionId='1'
    x:Class="AeroSync.UI.Views.JobDetailsDialog"
    x:Name="DialogHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    PrimaryButtonText="ĐÓNG CỬA SỔ">
    <StackPanel Spacing="14" MinWidth="780">
        <Grid>
            <StackPanel>
                <TextBlock Text="CHI TIẾT XỬ LÝ" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="{Binding Job.FileHash}" Foreground="#0B4EA2" FontWeight="SemiBold" />
            </StackPanel>
            <Border HorizontalAlignment="Right" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="14,8">
                <TextBlock Text="{Binding Job.Status}" Foreground="#DC2626" FontWeight="Bold" />
            </Border>
        </Grid>

        <!-- FILE RECORDS -->
        <StackPanel Spacing="6">
            <TextBlock Text="FILES:" Foreground="#0B4EA2" FontWeight="Bold" />
            <controls:DataGrid
                AutoGenerateColumns="False"
                GridLinesVisibility="All"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding FileRecords}"
                MaxHeight="140">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="FILE NAME" Binding="{Binding StoredFileName}" Width="*" />
                    <controls:DataGridTextColumn Header="SOURCE" Binding="{Binding SourceType}" Width="80" />
                    <controls:DataGridTextColumn Header="SENDER" Binding="{Binding Sender}" Width="160" />
                    <controls:DataGridTemplateColumn Header="ACTIONS" Width="180">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Open Folder"
                                            Command="{Binding ElementName=DialogHost, Path=DataContext.OpenFolderCommand}"
                                            CommandParameter="{Binding StoredPath}" />
                                    <Button Content="Copy Path"
                                            Command="{Binding ElementName=DialogHost, Path=DataContext.CopyPathCommand}"
                                            CommandParameter="{Binding StoredPath}" />
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </StackPanel>

        <!-- EMAIL CONTENT (only visible for email-sourced jobs) -->
        <StackPanel Spacing="6" Visibility="{Binding EmailSectionVisibility}">
            <TextBlock Text="NỘI DUNG EMAIL:" Foreground="#0B4EA2" FontWeight="Bold" />
            <Border BorderBrush="#D6E3F3" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Chủ đề:" Foreground="#64748B" />
                        <TextBlock Text="{Binding EmailSubject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding EmailBody}"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               MaxHeight="200"
                               Foreground="#334155" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="LOG CHI TIẾT:" Foreground="#DC2626" FontWeight="Bold" />
            <Border BorderBrush="#D6E3F3" BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="120">
                <TextBlock Text="{Binding StatusMessage}" FontFamily="Consolas" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="PREVIEW DỮ LIỆU (HÀNG LỖI):" Foreground="#0B4EA2" FontWeight="Bold" />
            <controls:DataGrid
                AutoGenerateColumns="False"
                GridLinesVisibility="All"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Job.RowErrors}"
                MaxHeight="220">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="ROW" Binding="{Binding RowNumber}" Width="80" />
                    <controls:DataGridTextColumn Header="FIELD" Binding="{Binding Field}" Width="160" />
                    <controls:DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="160" />
                    <controls:DataGridTextColumn Header="ERROR" Binding="{Binding Message}" Width="*" />
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="16">
            <Button Content="Chuyển sang /quarantine/" IsEnabled="False" />
            <Button Content="Gửi lại xử lý" Command="{Binding RetryCommand}" />
        </StackPanel>
    </StackPanel>
</ContentDialog>

