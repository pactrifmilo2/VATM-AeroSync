<Page
    x:Class="AeroSync.UI.Views.EmailResendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">
    <Grid Background="#F4F7FB" Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Spacing="3">
                <TextBlock Text="QUẢN LÝ RESEND EMAIL" FontSize="26" FontWeight="Bold" Foreground="#102A56" />
                <TextBlock Text="Tìm trên toàn bộ dữ liệu, lọc theo trạng thái, chọn một hoặc tất cả email và gửi lại tuần tự qua Gmail." Foreground="#64748B" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E8F7EE" BorderBrush="#B7E4C7" BorderThickness="1" CornerRadius="18" Padding="12,7">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <SymbolIcon Symbol="ProtectedDocument" Foreground="#15803D" />
                    <TextBlock Text="Dọn dữ liệu cũ sau khi gửi thành công" Foreground="#15803D" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#D9E2EF" BorderThickness="1" CornerRadius="12" Padding="16,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="Tên hoặc địa chỉ email người gửi" PlaceholderText="Ví dụ: tu1412000@gmail.com" Text="{Binding SenderFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNotLoading}" />
                <DatePicker Grid.Column="1" Header="Từ ngày" Date="{Binding FromDate, Mode=TwoWay}" IsEnabled="{Binding IsNotLoading}" />
                <DatePicker Grid.Column="2" Header="Đến ngày" Date="{Binding ToDate, Mode=TwoWay}" IsEnabled="{Binding IsNotLoading}" />
                <ComboBox Grid.Column="3" Header="Trạng thái chung" ItemsSource="{Binding OverallStatuses}" SelectedItem="{Binding SelectedOverallStatus, Mode=TwoWay}" IsEnabled="{Binding IsNotLoading}" />
                <ComboBox Grid.Column="4" Header="Trạng thái file" ItemsSource="{Binding AttachmentStatuses}" SelectedItem="{Binding SelectedAttachmentStatus, Mode=TwoWay}" IsEnabled="{Binding IsNotLoading}" />
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                    <Button Command="{Binding SearchCommand}" IsEnabled="{Binding IsNotLoading}" Background="#0B5CAD" Foreground="White" Padding="18,8">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <SymbolIcon Symbol="Find" />
                            <TextBlock Text="Tìm kiếm" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearCommand}" IsEnabled="{Binding IsNotLoading}" Padding="12,8" ToolTipService.ToolTip="Xóa bộ lọc"><SymbolIcon Symbol="Clear" /></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#D9E2EF" BorderThickness="1" CornerRadius="12" Padding="14,10">
                <StackPanel><TextBlock Text="EMAIL HIỂN THỊ" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding TotalEmails}" Foreground="#102A56" FontSize="24" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="12" Padding="14,10">
                <StackPanel><TextBlock Text="CẦN XỬ LÝ" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding ActionableEmails}" Foreground="#DC2626" FontSize="24" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="14,10">
                <StackPanel><TextBlock Text="HOÀN THÀNH" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding CompletedEmails}" Foreground="#16A34A" FontSize="24" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Grid.Column="3" Background="White" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="12" Padding="14,10">
                <StackPanel><TextBlock Text="ĐANG CHẶN" Foreground="#C2410C" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding BlockedEmails}" Foreground="#EA580C" FontSize="24" FontWeight="Bold" /></StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="#D9E2EF" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="16,10" Background="#F8FAFC">
                    <StackPanel>
                        <TextBlock Text="DANH SÁCH EMAIL" FontSize="16" FontWeight="Bold" Foreground="#174A8B" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                        <ProgressRing Width="24" Height="24" IsActive="{Binding IsLoading}" />
                        <Button Command="{Binding SearchCommand}" IsEnabled="{Binding IsNotLoading}" Padding="12,7">
                            <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Refresh" /><TextBlock Text="Làm mới" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Padding="16,9" Background="#EEF4FF" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Content="{Binding SelectAllLabel}"
                              IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsNotLoading}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectionLabel}" Foreground="#475569" VerticalAlignment="Center" />
                    <Button x:ConnectionId='7' Grid.Column="2"
                            Content="Resend email đã chọn"
                                                              
                            IsEnabled="{Binding CanResendSelected}"
                            Background="#0B5CAD"
                            Foreground="White"
                            Padding="18,8" />
                </Grid>

                <controls:DataGrid x:ConnectionId='2' Grid.Row="2" x:Name="EmailGrid"
                                   AutoGenerateColumns="False"
                                   GridLinesVisibility="Horizontal"
                                   HeadersVisibility="Column"
                                   IsReadOnly="True"
                                   IsEnabled="{Binding IsNotLoading}"
                                   ItemsSource="{Binding Emails}">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTemplateColumn Header="CHỌN" Width="64">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanResend}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTemplateColumn Header="NGƯỜI GỬI / TIÊU ĐỀ" Width="2.2*">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4" Spacing="2">
                                        <TextBlock Text="{Binding Sender}" Foreground="#0B5CAD" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Subject}" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MaskedMessageId}" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTextColumn Header="THỜI GIAN" Binding="{Binding ReceivedLabel}" Width="155" />
                        <controls:DataGridTextColumn Header="FILES" Binding="{Binding TotalAttachments}" Width="70" />
                        <controls:DataGridTextColumn Header="PHÂN BỔ TRẠNG THÁI" Binding="{Binding StatusBreakdown}" Width="2.4*" />
                        <controls:DataGridTemplateColumn Header="TỔNG THỂ" Width="120">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Border Background="#EEF4FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left"><TextBlock Text="{Binding OverallStatus}" Foreground="#174A8B" FontWeight="Bold" FontSize="11" /></Border></DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTextColumn Header="TIẾN ĐỘ" Binding="{Binding ResendState}" Width="125" />
                        <controls:DataGridTemplateColumn Header="HÀNH ĐỘNG" Width="105">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Button x:ConnectionId='3' Content="Resend"                            IsEnabled="{Binding CanResend}" Background="#0B5CAD" Foreground="White" Padding="14,6" /></DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="12,9">
            <Grid ColumnSpacing="9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <SymbolIcon Grid.Column="0" Symbol="Important" Foreground="#C2410C" />
                <TextBlock Grid.Column="1" Text="Mỗi email được gửi tuần tự để tránh quá tải Gmail. Sau khi Gmail gửi thành công, hệ thống xóa SHA-256, SyncJob và dữ liệu phép bay cũ; thông báo lịch sử vẫn được giữ lại. Email mới sẽ được ingest như lần đầu." Foreground="#9A3412" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Page>

