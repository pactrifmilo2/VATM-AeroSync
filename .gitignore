# Local secrets (copy from .env.example)
.env

# IDE / build
.idea/
*.iml
.vscode/
target/
dist/
bin/
obj/

# Logs
*.log
debug-*.log

# Microsoft Office documents (should not be versioned)
*.doc
*.docx
*.xlsx
*.xls
*.ppt
*.pptx

# Generated text files from Word
*.docx.txt

# PDF files
*.pdf

# Image files (screenshots, diagrams should be in docs/ with intention)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.svg

# Temporary files
*.tmp
.tmp/
*.txt

# Reports generated at runtime
reports/*.xlsx
reports/*.pdf
reports/corpus-run/
reports/permit-format-audit-*.xlsx
