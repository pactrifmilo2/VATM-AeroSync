<mxfile host="app.diagrams.net" modified="2026-10-23T14:20:00.000Z" agent="Codex" version="26.0.14">
<diagram id="e2e" name="End-to-end production flow"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="3200" pageHeight="1800"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="VATM AeroSync - luong production tu khoi dong den thanh cong" style="text;html=1;fontSize=24;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="1050" y="20" width="1000" height="40" as="geometry"/></mxCell>
<mxCell id="start" value="KHOI DONG&#xa;WinSW -> Run-Service.ps1 -> Java 21&#xa;AeroSyncApi | AeroSyncIngest | AeroSyncWorker" style="swimlane;html=1;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="90" width="510" height="310" as="geometry"/></mxCell>
<mxCell id="s1" value="Nap application.yaml + C:/AeroSync/config/.env&#xa;Tao DataSource, RabbitTemplate, Redis client" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="start"><mxGeometry x="30" y="50" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="s2" value="API: ensureDefaults runtime_config&#xa;allowlist/blacklist, scheduler settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="start"><mxGeometry x="270" y="50" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="s3" value="Ingest: @Scheduled tick 10s&#xa;mode EMAIL | FOLDER | BOTH&#xa;config cache 5s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="start"><mxGeometry x="30" y="160" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="s4" value="Worker: nap permit-formats/*.yaml&#xa;validate id/extends/regex/schema&#xa;listener + retry interceptor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="start"><mxGeometry x="270" y="160" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="source" value="NGUON DU LIEU" style="swimlane;html=1;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="470" width="510" height="720" as="geometry"/></mxCell>
<mxCell id="folder" value="Incoming folder&#xa;Files.list regular files, sort name&#xa;limit maxFilesPerCycle&#xa;SHA-256 -> Redis path-seen&#xa;dedupe hash -> duplicate: SyncJob SKIPPED + audit&#xa;new: SyncJob PENDING + FileRecord DOWNLOADED/PENDING&#xa;register hash + detect priority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="source"><mxGeometry x="25" y="50" width="220" height="220" as="geometry"/></mxCell>
<mxCell id="email" value="IMAP email&#xa;fetchMessages(shouldDownload): UID + Message-ID + allowlist/blacklist&#xa;luu tat ca attachment vao incoming/email-attachments/yyyyMMdd&#xa;cancelled/blocked/no attachment/unsupported: EmailMetadata terminal, no event&#xa;attachment hop le: SHA-256/dedupe -> SyncJob PENDING + FileRecord EMAIL + EmailMetadata&#xa;markIngestComplete khi du attachment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="source"><mxGeometry x="265" y="50" width="220" height="290" as="geometry"/></mxCell>
<mxCell id="publish" value="IngestPublisher&#xa;FileIngestedEvent(jobId,path,hash,source,priority,subject)&#xa;file.ingested / routing key file.processing&#xa;Audit INCOMING_FILE_ACCEPTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="source"><mxGeometry x="130" y="410" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="rabbit" value="RABBITMQ&#xa;file.ingested (direct)&#xa;file.processing.queue durable, priority 10&#xa;sync.result (fanout)&#xa;file.processing.failed.queue durable" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1"><mxGeometry x="650" y="600" width="290" height="145" as="geometry"/></mxCell>
<mxCell id="worker" value="WORKER PIPELINE: FileProcessingPipeline.process(event)" style="swimlane;html=1;startSize=25;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1030" y="90" width="2100" height="1100" as="geometry"/></mxCell>
<mxCell id="w1" value="1. @RabbitListener&#xa;resolveProcessingPath: event path; fallback FileRecord storedPath moi nhat&#xa;lookup sender/receivedDate&#xa;SyncJob=IN_PROGRESS; FileRecord/EmailMetadata=PROCESSING" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="worker"><mxGeometry x="25" y="50" width="260" height="115" as="geometry"/></mxCell>
<mxCell id="w2" value="2. FormatValidator&#xa;regular file, extension, non-empty&#xa;size &lt;= 10 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="worker"><mxGeometry x="320" y="65" width="170" height="85" as="geometry"/></mxCell>
<mxCell id="w3" value="3. ParserStep&#xa;DOCX: XWPF + DocxSchedulePermitParser&#xa;DOC: legacy revision parser&#xa;doc paragraph/table/context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="worker"><mxGeometry x="525" y="55" width="210" height="105" as="geometry"/></mxCell>
<mxCell id="w4" value="4. Format detector&#xa;IATA/ICAO + detection patterns&#xa;direct/relaxed revision rules&#xa;highest profile priority; tie => error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="worker"><mxGeometry x="770" y="55" width="210" height="105" as="geometry"/></mxCell>
<mxCell id="w5" value="5. YAML profile parse&#xa;permit no/date/operator/purpose&#xa;OLD/NEW schedule, route, aircraft, time, service days&#xa;=> SchedulePermit + ScheduleFlight[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="worker"><mxGeometry x="1015" y="50" width="230" height="115" as="geometry"/></mxCell>
<mxCell id="w6" value="6. Normalize + subject directive&#xa;normalize callsign/airport/time/date/route&#xa;CORRECT/UPDATE/CORR => SUBJECT_CORRECTION&#xa;PurposeResolution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="worker"><mxGeometry x="1280" y="55" width="220" height="105" as="geometry"/></mxCell>
<mxCell id="w7" value="7. RevisionReconciliation&#xa;new/revision/cancel/reference-season&#xa;tim baseline ATFM theo permit + OLD rows&#xa;OLD phai match duy nhat; materialize OLD/NEW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="worker"><mxGeometry x="1535" y="50" width="245" height="115" as="geometry"/></mxCell>
<mxCell id="w8" value="8. Resolve aircraft + Via&#xa;ATFM dictionary/cache&#xa;BusinessRuleValidator&#xa;permit/operator/flight/route/ETD/ETA/date/service/craft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="worker"><mxGeometry x="1815" y="50" width="240" height="115" as="geometry"/></mxCell>
<mxCell id="w9" value="9. DatabaseWriter&#xa;LandingFlightFilter, remarks, EM ddMMyyyy reference&#xa;PermitImport RESERVED: semantic/source hash, lock, idempotency&#xa;duplicate/revision-review guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="worker"><mxGeometry x="25" y="270" width="305" height="120" as="geometry"/></mxCell>
<mxCell id="gate" value="APP_ATFM_WRITE_ENABLED?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="worker"><mxGeometry x="375" y="280" width="130" height="100" as="geometry"/></mxCell>
<mxCell id="w10" value="10. ATFM transaction&#xa;seasonal/HVN referenced -> T_PERMMASTER_SC/T_PERMDETAIL_SC&#xa;non-seasonal -> T_PERMMASTER_NO/T_PERMDETAIL_NO&#xa;insert/replace/cancel workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="worker"><mxGeometry x="550" y="265" width="310" height="130" as="geometry"/></mxCell>
<mxCell id="w11" value="11. Tracking transaction&#xa;PermitImport=SAVED or DUPLICATE&#xa;FileRecord=SAVED/SKIPPED + rows/count/date&#xa;SyncJob=SUCCESS/SKIPPED&#xa;Audit SYNC_SUCCESS/SYNC_DUPLICATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="worker"><mxGeometry x="905" y="265" width="260" height="130" as="geometry"/></mxCell>
<mxCell id="w12" value="12. Archive&#xa;short SHA-256 suffix; no overwrite&#xa;processed/yyyy/MM/dd (filesystem: processed/incoming)&#xa;FileRecord storedPath/archiveStatus=ARCHIVED&#xa;EmailMetadata=SAVED/SKIPPED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="worker"><mxGeometry x="1210" y="265" width="270" height="130" as="geometry"/></mxCell>
<mxCell id="w13" value="13. Publish SyncResultEvent&#xa;SUCCESS/SKIPPED, INFO, message, timestamp&#xa;import warning: audit + WARNING result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="worker"><mxGeometry x="1525" y="270" width="240" height="115" as="geometry"/></mxCell>
<mxCell id="fail" value="LOI / RETRY&#xa;Format => error-format&#xa;Business/reference => quarantine&#xa;Runtime => error&#xa;cap nhat job/file/email + audit + WARNING&#xa;retry max 2, het retry -> file.processing.failed.queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="worker"><mxGeometry x="1810" y="265" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="atfm" value="ORACLE ATFM&#xa;permit master/detail&#xa;airport, aircraft, route dictionaries" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="1240" y="1270" width="280" height="85" as="geometry"/></mxCell>
<mxCell id="db" value="ORACLE AEROSYNC TRACKING&#xa;sync_job | file_record | email_metadata | permit_import | audit_log | runtime_config | dashboard_alert" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="1650" y="1265" width="430" height="95" as="geometry"/></mxCell>
<mxCell id="finish" value="HOAN TAT THANH CONG&#xa;ATFM committed; tracking SUCCESS/SAVED; file archived; result published;&#xa;neu email: IMAP acknowledgement move vao AeroSync/Processed" style="shape=doubleEllipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="2300" y="1265" width="450" height="100" as="geometry"/></mxCell>
<mxCell id="end" value="SAU sync.result fanout&#xa;API: dashboard.alerts.queue -> AlertService (WARNING/CRITICAL -> DashboardAlert); UI REST doc jobs/reports/audit&#xa;Ingest: email.acknowledgement.queue -> EmailMetadata status; khi ingestComplete + tat ca attachment terminal:&#xa;all SAVED/SKIPPED -> IMAP AeroSync/Processed, MOVED_PROCESSED; con lai -> AeroSync/Error, MOVED_ERROR; loi move -> retry scheduler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="650" y="1470" width="2100" height="150" as="geometry"/></mxCell>
