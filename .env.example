# VATM AeroSync — local environment template
#
# Setup:
#   copy .env.example .env
#   Edit .env with your real values (never commit .env)
#
# Run apps from the repo root so Spring loads .env automatically:
#   java -jar aerosync-ingest\target\aerosync-ingest-0.0.1-SNAPSHOT.jar
#
# One command (Docker + build + all apps):
#   .\run-aerosync.bat
# Or:  .\scripts\run-aerosync.ps1

# --- Oracle (matches docker-compose.yml) ---
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
SPRING_DATASOURCE_USERNAME=vatm_user
SPRING_DATASOURCE_PASSWORD=vatm_password

# --- RabbitMQ ---
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# --- Redis ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# --- File storage (create these folders on your machine) ---
APP_FILE_PATHS_INCOMING=C:/vatm-storage/incoming
APP_FILE_PATHS_PROCESSED=C:/vatm-storage/processed
APP_FILE_PATHS_ERROR=C:/vatm-storage/error
APP_FILE_PATHS_QUARANTINE=C:/vatm-storage/quarantine

# --- Email ingest (IMAP) — optional; leave password empty to skip live mail ---
APP_EMAIL_HOST=imap.gmail.com
APP_EMAIL_PORT=993
APP_EMAIL_PROTOCOL=imaps
APP_EMAIL_USERNAME=you@gmail.com
APP_EMAIL_PASSWORD=
APP_EMAIL_FOLDER=INBOX
APP_EMAIL_WHITELIST_SENDERS_0=you@gmail.com

# --- Ingest scheduler (ms). Use 30000 for faster local testing ---
APP_INGEST_SCHEDULER_FIXED_DELAY_MS=300000
APP_INGEST_MAX_FILES_PER_CYCLE=100

# --- Dashboard API ---
SERVER_PORT=8080
